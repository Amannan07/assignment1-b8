{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {    
    "rootDir": "./src",
    "outDir": "./dist",

        
    "module": "esnext",
    "target": "esnext",
    "types": [],
    
    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  }
}
